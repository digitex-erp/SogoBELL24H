// SHOGO:CUSTOM-START prisma-header
// Managed by Shogo. Do not add a datasource `url` or change the generator `provider` — the database URL is configured in prisma.config.ts (Prisma 7+).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}
// SHOGO:CUSTOM-END

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  passwordHash   String    @map("password_hash")
  role           String    @default("viewer")
  organizationId String?   @map("organization_id")
  emailVerified  Boolean   @default(false) @map("email_verified")
  avatarUrl      String?   @map("avatar_url")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  campaigns      Campaign[]
  contents       Content[]
  images         ImageAsset[]
  jobs           Job[]
  leads          Lead[]
  activities     Activity[]
  auditLogs      AuditLog[]
  apiKeys        ApiProviderKey[]

  @@map("users")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  plan        String   @default("free")
  timezone    String   @default("Asia/Kolkata")
  currency    String   @default("INR")
  logoUrl     String?  @map("logo_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members     OrgMember[]

  @@map("organizations")
}

model OrgMember {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           String   @default("viewer")
  invitedAt      DateTime @default(now()) @map("invited_at")
  joinedAt       DateTime? @map("joined_at")

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, userId])
  @@map("org_members")
}

model ApiProviderKey {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  provider       String
  apiKeyEncrypted String @map("api_key_encrypted")
  model          String?
  isEnabled      Boolean  @default(true) @map("is_enabled")
  priority       Int      @default(1)
  rateLimit      Int?     @map("rate_limit")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user           User     @relation(fields: [userId], references: [id])

  @@unique([userId, provider])
  @@map("api_provider_keys")
}

model ProviderUsage {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  provider       String
  model          String?
  inputTokens    Int      @default(0) @map("input_tokens")
  outputTokens   Int      @default(0) @map("output_tokens")
  costUsd        Float    @default(0) @map("cost_usd")
  latencyMs      Int?     @map("latency_ms")
  success        Boolean  @default(true)
  recordedAt     DateTime @default(now()) @map("recorded_at")

  @@map("provider_usage")
}

model Campaign {
  id           String   @id @default(cuid())
  name         String
  status       String   @default("draft")
  objective    String?
  budget       Float    @default(0)
  spent        Float    @default(0)
  currency     String   @default("INR")
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  conversions  Int      @default(0)
  userId       String?  @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User?    @relation(fields: [userId], references: [id])
  contents     Content[]

  @@map("campaigns")
}

model Content {
  id          String   @id @default(cuid())
  title       String
  type        String   @default("blog_post")
  body        String?
  status      String   @default("draft")
  language    String   @default("en")
  platform    String?
  url         String?
  wordCount   Int      @default(0) @map("word_count")
  campaignId  String?  @map("campaign_id")
  userId      String?  @map("user_id")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])

  @@map("contents")
}

model ImageAsset {
  id              String   @id @default(cuid())
  title           String?
  description     String?
  prompt          String?
  negativePrompt  String?  @map("negative_prompt")
  url             String
  thumbnail       String?
  width           Int?
  height          Int?
  aspectRatio     String?  @map("aspect_ratio")
  fileSize        Int?     @map("file_size")
  format          String?  @default("png")
  provider        String?
  model           String?
  generationType  String   @default("text_to_image") @map("generation_type")
  seed            Int?
  cfg             Float?
  steps           Int?
  quality         String?
  numOutputs      Int      @default(1) @map("num_outputs")
  costUsd         Float?   @map("cost_usd")
  latencyMs       Int?     @map("latency_ms")
  status          String   @default("completed")
  errorMsg        String?  @map("error_msg")
  brandKitId      String?  @map("brand_kit_id")
  collectionId    String?  @map("collection_id")
  campaignId      String?  @map("campaign_id")
  tags            String?
  metadata        String?
  isFavorite      Boolean  @default(false) @map("is_favorite")
  isArchived      Boolean  @default(false) @map("is_archived")
  version         Int      @default(1)
  parentId        String?  @map("parent_id")
  userId          String   @map("user_id")
  orgId           String?  @map("org_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User?    @relation(fields: [userId], references: [id])
  collection      ImageCollection? @relation(fields: [collectionId], references: [id])
  brandKit        BrandKit? @relation(fields: [brandKitId], references: [id])
  versions        ImageVersion[]
  edits           ImageEdit[]
  costRecords     ImageCostRecord[]

  @@index([userId])
  @@index([collectionId])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
  @@map("image_assets")
}

model Job {
  id          String   @id @default(cuid())
  type        String
  status      String   @default("queued")
  priority    Int      @default(2)
  payload     String?
  result      String?
  error       String?
  attempts    Int      @default(0)
  maxAttempts Int      @default(3) @map("max_attempts")
  userId      String?  @map("user_id")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User?    @relation(fields: [userId], references: [id])

  @@map("jobs")
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  company     String?
  status      String   @default("new")
  source      String?
  score       Int      @default(0)
  value       Float    @default(0)
  tags        String?
  notes       String?
  userId      String?  @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User?    @relation(fields: [userId], references: [id])
  activities  Activity[]
  deals       Deal[]

  @@map("leads")
}

model Activity {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String?
  leadId      String?  @map("lead_id")
  userId      String?  @map("user_id")
  scheduledAt DateTime? @map("scheduled_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  lead        Lead?    @relation(fields: [leadId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])

  @@map("activities")
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  resource    String
  resourceId  String?  @map("resource_id")
  details     String?
  userId      String?  @map("user_id")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Notification {
  id          String   @id @default(cuid())
  title       String
  message     String
  type        String   @default("info")
  read        Boolean  @default(false)
  actionUrl   String?  @map("action_url")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model SystemMetric {
  id          String   @id @default(cuid())
  name        String
  value       Float
  labels      String?
  recordedAt  DateTime @default(now()) @map("recorded_at")

  @@map("system_metrics")
}

// ═══════════════════════════════════════════════════════════
// SPRINT 2: Prompt Library & AI Studio Models
// ═══════════════════════════════════════════════════════════

model Prompt {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   @default("general")
  content     String
  variables   String?
  systemPrompt String?  @map("system_prompt")
  isTemplate  Boolean  @default(false) @map("is_template")
  isPublic    Boolean  @default(false) @map("is_public")
  isArchived  Boolean  @default(false) @map("is_archived")
  tags        String?
  folderId    String?  @map("folder_id")
  userId      String   @map("user_id")
  orgId       String?  @map("org_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  versions    PromptVersion[]
  executions  PromptExecution[]
  favorites   PromptFavorite[]
  folder      PromptFolder? @relation(fields: [folderId], references: [id])

  @@map("prompts")
}

model PromptFolder {
  id        String   @id @default(cuid())
  name      String
  icon      String?  @default("folder")
  color     String?  @default("#6366f1")
  parentId  String?  @map("parent_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  prompts   Prompt[]

  @@map("prompt_folders")
}

model PromptFavorite {
  id        String   @id @default(cuid())
  promptId  String   @map("prompt_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, userId])
  @@map("prompt_favorites")
}

model PromptVersion {
  id        String   @id @default(cuid())
  promptId  String   @map("prompt_id")
  version   Int      @default(1)
  content   String
  variables String?
  systemPrompt String? @map("system_prompt")
  changelog String?
  createdAt DateTime @default(now()) @map("created_at")

  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, version])
  @@map("prompt_versions")
}

model PromptExecution {
  id              String   @id @default(cuid())
  promptId        String?  @map("prompt_id")
  provider        String
  model           String
  inputTokens     Int      @default(0) @map("input_tokens")
  outputTokens    Int      @default(0) @map("output_tokens")
  totalTokens     Int      @default(0) @map("total_tokens")
  costUsd         Float    @default(0) @map("cost_usd")
  latencyMs       Int      @default(0) @map("latency_ms")
  input           String?
  output          String?
  systemPrompt    String?  @map("system_prompt")
  temperature     Float?
  topP            Float?   @map("top_p")
  frequencyPenalty Float?  @map("frequency_penalty")
  presencePenalty  Float?  @map("presence_penalty")
  status          String   @default("success")
  errorMsg        String?  @map("error_msg")
  userId          String   @map("user_id")
  orgId           String?  @map("org_id")
  ipAddress       String?  @map("ip_address")
  createdAt       DateTime @default(now()) @map("created_at")

  prompt          Prompt?  @relation(fields: [promptId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([provider])
  @@index([createdAt])
  @@map("prompt_executions")
}

model BudgetAlert {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  orgId       String?  @map("org_id")
  name        String
  threshold   Float
  period      String   @default("monthly")
  provider    String?
  metric      String   @default("cost")
  channel     String   @default("notification")
  isActive    Boolean  @default(true) @map("is_active")
  lastTriggered DateTime? @map("last_triggered")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("budget_alerts")
}

model RateLimitRecord {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  provider  String
  requests  Int      @default(0)
  windowStart DateTime @map("window_start")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, provider, windowStart])
  @@map("rate_limit_records")
}

model ModelCatalog {
  id              String   @id @default(cuid())
  provider        String
  modelId         String   @map("model_id")
  name            String
  description     String?
  inputPricePer1k Float    @map("input_price_per_1k")
  outputPricePer1k Float   @map("output_price_per_1k")
  maxTokens       Int      @map("max_tokens")
  contextWindow   Int      @map("context_window")
  capabilities    String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([provider, modelId])
  @@map("model_catalog")
}

// ═══════════════════════════════════════════════════════════
// SPRINT 3: Enterprise Image Factory
// ═══════════════════════════════════════════════════════════

model ImageCollection {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String?  @default("folder")
  color       String?  @default("#6366f1")
  parentId    String?  @map("parent_id")
  userId      String   @map("user_id")
  orgId       String?  @map("org_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  images      ImageAsset[]

  @@map("image_collections")
}

model ImageVersion {
  id          String   @id @default(cuid())
  imageId     String   @map("image_id")
  version     Int      @default(1)
  url         String
  thumbnail   String?
  prompt      String?
  negativePrompt String? @map("negative_prompt")
  seed        Int?
  cfg         Float?
  steps       Int?
  quality     String?
  provider    String?
  model       String?
  costUsd     Float?   @map("cost_usd")
  latencyMs   Int?     @map("latency_ms")
  editParams  String?  @map("edit_params")
  changelog   String?
  createdAt   DateTime @default(now()) @map("created_at")

  image       ImageAsset @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([imageId, version])
  @@map("image_versions")
}

model ImageEdit {
  id          String   @id @default(cuid())
  imageId     String   @map("image_id")
  type        String
  params      String?
  inputUrl    String?  @map("input_url")
  outputUrl   String?  @map("output_url")
  provider    String?
  model       String?
  costUsd     Float?   @map("cost_usd")
  latencyMs   Int?     @map("latency_ms")
  status      String   @default("completed")
  errorMsg    String?  @map("error_msg")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  image       ImageAsset @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@map("image_edits")
}

model ImageCostRecord {
  id          String   @id @default(cuid())
  imageId     String?  @map("image_id")
  userId      String   @map("user_id")
  orgId       String?  @map("org_id")
  provider    String
  model       String
  operation   String
  costUsd     Float    @default(0) @map("cost_usd")
  credits     Int      @default(0)
  inputTokens Int?     @map("input_tokens")
  outputTokens Int?    @map("output_tokens")
  metadata    String?
  createdAt   DateTime @default(now()) @map("created_at")

  image       ImageAsset? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([provider])
  @@index([createdAt])
  @@map("image_cost_records")
}

model BrandKit {
  id          String   @id @default(cuid())
  name        String
  description String?
  logoUrl     String?  @map("logo_url")
  logoUrls    String?  @map("logo_urls")
  colors      String?
  fonts       String?
  brandVoice  String?  @map("brand_voice")
  templates   String?
  backgrounds String?
  watermarks  String?
  safeZones   String?  @map("safe_zones")
  guidelines  String?
  isDefault   Boolean  @default(false) @map("is_default")
  userId      String   @map("user_id")
  orgId       String?  @map("org_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  images      ImageAsset[]

  @@map("brand_kits")
}

model ImageTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   @default("general")
  platform    String?
  width       Int
  height      Int
  aspectRatio String?  @map("aspect_ratio")
  prompt      String?
  negativePrompt String? @map("negative_prompt")
  thumbnail   String?
  tags        String?
  isSystem    Boolean  @default(false) @map("is_system")
  isPublic    Boolean  @default(true) @map("is_public")
  userId      String?  @map("user_id")
  usageCount  Int      @default(0) @map("usage_count")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("image_templates")
}

model ImageQueueJob {
  id          String   @id @default(cuid())
  type        String   @default("generate")
  status      String   @default("queued")
  priority    Int      @default(2)
  progress    Int      @default(0)
  prompt      String?
  negativePrompt String? @map("negative_prompt")
  provider    String?
  model       String?
  params      String?
  resultUrl   String?  @map("result_url")
  thumbnail   String?
  error       String?
  attempts    Int      @default(0)
  maxAttempts Int      @default(3) @map("max_attempts")
  estimatedMs Int?     @map("estimated_ms")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  pausedAt    DateTime? @map("paused_at")
  userId      String   @map("user_id")
  orgId       String?  @map("org_id")
  campaignId  String?  @map("campaign_id")
  collectionId String? @map("collection_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status, priority])
  @@index([userId])
  @@map("image_queue_jobs")
}

model ImageEditorState {
  id          String   @id @default(cuid())
  imageId     String   @map("image_id")
  state       String
  history     String?
  currentStep Int      @default(0) @map("current_step")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("image_editor_states")
}

// ═══════════════════════════════════════════════════════════
// SPRINT 3A: Enterprise AI Router Hardening
// ═══════════════════════════════════════════════════════════

model RoutingPolicy {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  type        String   @default("system")  // system | custom
  strategy    String   // fastest | cheapest | highest_quality | balanced | fallback_only
  config      String?  // JSON: { maxCostPerToken, minQualityScore, requiredCapabilities, regionRestrictions, etc. }
  isActive    Boolean  @default(true) @map("is_active")
  priority    Int      @default(0)
  userId      String?  @map("user_id")
  orgId       String?  @map("org_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  telemetry   RouterTelemetry[]

  @@map("routing_policies")
}

model ProviderCapability {
  id          String   @id @default(cuid())
  provider    String
  capability  String   // chat | vision | images | audio_in | audio_out | video | embeddings | json_mode | reasoning | function_calling
  modelId     String?  @map("model_id")
  region      String?  // global | us | eu | in | cn | private
  isAvailable Boolean  @default(true) @map("is_available")
  metadata    String?  // JSON: { maxResolution, supportedFormats, rateLimit, etc. }
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([provider, capability, modelId])
  @@index([provider])
  @@index([capability])
  @@map("provider_capabilities")
}

model CircuitBreaker {
  id               String   @id @default(cuid())
  provider         String
  userId           String   @map("user_id")
  state            String   @default("closed")  // closed | open | half_open
  failureCount     Int      @default(0) @map("failure_count")
  successCount     Int      @default(0) @map("success_count")
  failureThreshold Int      @default(5) @map("failure_threshold")
  recoveryTimeoutMs Int     @default(300000) @map("recovery_timeout_ms")  // 5 minutes default
  lastFailureAt    DateTime? @map("last_failure_at")
  lastSuccessAt    DateTime? @map("last_success_at")
  halfOpenMaxCalls Int      @default(3) @map("half_open_max_calls")
  halfOpenAttempts Int      @default(0) @map("half_open_attempts")
  totalTrips       Int      @default(0) @map("total_trips")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([provider, userId])
  @@index([provider])
  @@map("circuit_breakers")
}

model ProviderBenchmark {
  id          String   @id @default(cuid())
  provider    String
  modelId     String   @map("model_id")
  userId      String?  @map("user_id")
  qualityScore Float   @default(0) @map("quality_score")    // 0-100
  latencyMs   Int      @default(0) @map("latency_ms")
  costPer1k   Float    @default(0) @map("cost_per_1k")
  reliability Float    @default(100)  // 0-100 success rate
  availability Float   @default(100) // 0-100 uptime
  successRate Float    @default(100) @map("success_rate")
  sampleSize  Int      @default(0) @map("sample_size")
  compositeScore Float @default(0) @map("composite_score") // weighted score
  benchmarkType String @default("live") @map("benchmark_type") // live | synthetic | historical
  metadata    String?  // JSON
  recordedAt  DateTime @default(now()) @map("recorded_at")

  @@index([provider, modelId])
  @@index([recordedAt])
  @@map("provider_benchmarks")
}

model RouterTelemetry {
  id           String   @id @default(cuid())
  requestId    String   @map("request_id")
  correlationId String? @map("correlation_id")
  userId       String?  @map("user_id")
  orgId        String?  @map("org_id")
  policyId     String?  @map("policy_id")
  workflowType String?  @map("workflow_type") // chat | image | video | voice | embeddings | reasoning | coding
  requestedProvider String? @map("requested_provider")
  actualProvider    String? @map("actual_provider")
  model        String?
  status       String   // success | error | fallback | timeout | circuit_broken
  latencyMs    Int      @default(0) @map("latency_ms")
  queueTimeMs  Int      @default(0) @map("queue_time_ms")
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  costUsd      Float    @default(0) @map("cost_usd")
