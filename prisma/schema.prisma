  successCriteria     String?  @map("success_criteria")
  failureCriteria     String?  @map("failure_criteria")
  escalationRules     String?  @map("escalation_rules")
  workingHours        String?  @map("working_hours")
  maxCallsPerDay      Int      @default(60) @map("max_calls_per_day")
  escalationThreshold Float    @default(0.55) @map("escalation_threshold")
